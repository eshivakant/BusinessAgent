# Application
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8080
INTERNAL_API_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# Worker queue
REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=business-agent

# Conversation memory (Telegram continuity)
CONVERSATION_ENABLED=true
CONVERSATION_WINDOW_MESSAGES=8
CONVERSATION_SUMMARY_MAX_CHARS=1200
CONVERSATION_CONTEXT_MAX_CHARS=2500
CONVERSATION_TTL_SECONDS=604800
TELEGRAM_UI_STATE_TTL_SECONDS=86400

# Qdrant memory
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=business_agent_memory
QDRANT_VECTOR_SIZE=256
QDRANT_DISTANCE=Cosine

# Ingestion
INGESTION_ALLOWED_LOCAL_DIR=/data/docs
INGESTION_CHUNK_SIZE=1200
INGESTION_CHUNK_OVERLAP=200
INGESTION_SUMMARY_SENTENCES=5
INGESTION_MAX_DOCUMENT_CHARS=200000

# Read-only SQL access (use read-only DB credentials)
SQL_DATABASE_URL=
SQL_ALLOWED_TABLES=
SQL_QUERY_LIMIT_DEFAULT=100
SQL_QUERY_LIMIT_MAX=1000

# Docker / Traefik / VPS integration
APP_NETWORK_EXTERNAL=true
EXTERNAL_DOCKER_NETWORK=app-network
TRAEFIK_ENABLE=false
TRAEFIK_HOST=business-agent.example.com
